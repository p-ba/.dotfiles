<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Swift Symbols</string>
    <key>scope</key>
    <string>source.swift entity.name.type</string>
    <key>settings</key>
    <dict>
        <key>showInSymbolList</key>
        <integer>1</integer>
        <key>showInIndexedSymbolList</key>
        <integer>1</integer>
        <key>symbolTransformation</key>
        <string>s/^(?:enum|class|struct|protocol|extension)\s+([A-Za-z_][A-Za-z0-9_]*).*$/$1/g;</string>
        <key>symbolIndexTransformation</key>
        <string>s/^(?:enum|class|struct|protocol|extension)\s+([A-Za-z_][A-Za-z0-9_]*).*$/$1/g;</string>
    </dict>
</dict>
</plist>
